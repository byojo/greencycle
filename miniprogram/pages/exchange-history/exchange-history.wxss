.page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 24rpx;
  box-sizing: border-box;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #9CA3AF;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
  flex-shrink: 0;
}

.card-body {
  flex: 1;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.card-points {
  font-size: 26rpx;
  color: #EF4444;
  margin-top: 8rpx;
}

.card-status {
  font-size: 22rpx;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.status-1 {
  background: #FEF3C7;
  color: #D97706;
}

.status-2 {
  background: #DBEAFE;
  color: #2563EB;
}

.status-3 {
  background: #D1FAE5;
  color: #059669;
}

.status-4 {
  background: #FEE2E2;
  color: #DC2626;
}

.card-date {
  font-size: 22rpx;
  color: #9CA3AF;
  flex-shrink: 0;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #9CA3AF;
  font-size: 26rpx;
}
