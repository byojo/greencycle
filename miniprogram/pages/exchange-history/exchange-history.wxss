.page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 24rpx;
  box-sizing: border-box;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #9CA3AF;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.card-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.card-points {
  font-size: 26rpx;
  color: #EF4444;
  margin-top: 8rpx;
}

.card-status {
  font-size: 22rpx;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  font-weight: 500;
}

.card-date {
  font-size: 22rpx;
  color: #9CA3AF;
  flex-shrink: 0;
  align-self: flex-start;
}

.delivery-info {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3F4F6;
}

.delivery-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.delivery-label {
  font-size: 24rpx;
  color: #9CA3AF;
  width: 120rpx;
  flex-shrink: 0;
}

.delivery-value {
  font-size: 24rpx;
  color: #4B5563;
  flex: 1;
  word-break: break-all;
}

.delivery-hint {
  font-size: 24rpx;
  color: #F59E0B;
  flex: 1;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #9CA3AF;
  font-size: 26rpx;
}
