<!--pages/order-list/order-list.wxml-->
<view class="page">
  <!-- 顶部导航 -->
  <view class="nav">
    <view class="nav-inner">
      <view class="nav-back" bindtap="onBack">‹</view>
      <view class="nav-title">我的订单</view>
    </view>
  </view>

  <!-- 时间提示行 -->
  <view class="time-hint" wx:if="{{!loading && groupedOrders.length > 0}}">
    <text class="hint-text">点击可加载更早订单</text>
    <text wx:if="{{hasMore}}" class="hint-more" bindtap="onMore">{{loadingMore ? '加载中...' : '查看更早 ›'}}</text>
    <text wx:else class="hint-more hint-disabled">已无更早订单</text>
  </view>

  <!-- 状态筛选 -->
  <scroll-view scroll-x class="status-tabs">
    <view class="tab {{status === 0 ? 'active' : ''}}" data-status="0" bindtap="onStatusChange">全部</view>
    <view class="tab {{status === 1 ? 'active' : ''}}" data-status="1" bindtap="onStatusChange">待评估</view>
    <view class="tab {{status === 2 ? 'active' : ''}}" data-status="2" bindtap="onStatusChange">已派单</view>
    <view class="tab {{status === 3 ? 'active' : ''}}" data-status="3" bindtap="onStatusChange">已取件</view>
    <view class="tab {{status === 4 ? 'active' : ''}}" data-status="4" bindtap="onStatusChange">已完成</view>
    <view class="tab {{status === 5 ? 'active' : ''}}" data-status="5" bindtap="onStatusChange">已取消</view>
  </scroll-view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-icon"></view>
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{groupedOrders.length === 0}}" class="empty-state">
    <view class="empty-icon">📭</view>
    <view class="empty-text">暂无订单</view>
    <button class="empty-btn" bindtap="goHome">去下单</button>
  </view>

  <!-- 订单列表 -->
  <block wx:else>
    <view wx:for="{{groupedOrders}}" wx:key="month" wx:for-item="group">
      <view class="month-title">{{group.monthLabel}}</view>
      <view class="order-list">
        <view
          class="order-card"
          wx:for="{{group.list}}"
          wx:key="id"
          wx:for-item="order"
          data-id="{{order.id}}"
          data-category="{{order.categoryCode}}"
          bindtap="onOrderTap"
        >
          <view class="card-head">
            <text class="card-meta">下单时间 {{order.createdAtText}}</text>
            <view class="status-badge status-{{order.status}}">{{order.statusText}}</view>
          </view>
          <view class="card-body">
            <view class="type-row">
              <view class="type-tag">{{order.categoryName}}</view>
              <text class="item-name">{{order.itemName}}</text>
            </view>
            <view class="info-line"><text class="line-key">预约时间</text><text class="line-val">{{order.estimatedAtText || '尽快上门'}}</text></view>
            <view class="info-line"><text class="line-key">联系方式</text><text class="line-val">{{order.pickupPhone || '—'}}</text></view>
            <view class="info-line"><text class="line-key">地址</text><text class="line-val">{{order.pickupAddr}}</text></view>
          </view>
          <view class="card-photos" wx:if="{{order.images && order.images.length > 0}}">
            <image wx:for="{{order.images}}" wx:for-item="img" wx:key="id" src="{{img.url}}" mode="aspectFill" class="photo-thumb" catchtap="onPreviewPhoto" data-urls="{{order.images}}" data-current="{{img.url}}"></image>
          </view>
          <view class="card-actions" catchtap="stopPropagation">
            <view class="detail-link" data-id="{{order.id}}" data-category="{{order.categoryCode}}" bindtap="onOrderTap">详情 ›</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部提示 -->
  <view class="footer-tip">— 已显示全部订单 —</view>

  <!-- 底部安全区占位 -->
  <view class="safe-area-bottom" style="height: 140rpx;"></view>
</view>
