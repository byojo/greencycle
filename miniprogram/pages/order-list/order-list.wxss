/* pages/order-list/order-list.wxss */
.page {
  min-height: 100vh;
  background: #F7F8FA;
}

.status-tabs { white-space: nowrap; padding: 16rpx 24rpx; background: #FFFFFF; border-bottom: 1rpx solid #F3F4F6; }
.status-tabs .tab { display: inline-block; padding: 8rpx 28rpx; margin-right: 16rpx; border-radius: 32rpx; font-size: 26rpx; color: #6B7280; background: #F3F4F6; }
.status-tabs .tab.active { background: #07C160; color: #fff; }

/* ============ 顶部导航 ============ */
.nav {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F3F4F6;
  padding-top: calc(env(safe-area-inset-top) + 12rpx);
}
.nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 100%;
}
.nav-back {
  position: absolute;
  left: 0;
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #1F2937;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2937;
  text-align: center;
  flex: 1;
}

/* ============ 筛选 chips ============ */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  position: sticky;
  top: calc(88rpx + env(safe-area-inset-top));
  z-index: 9;
  border-bottom: 1rpx solid #F3F4F6;
}
.filter-chip {
  padding: 12rpx 32rpx;
  border-radius: 100rpx;
  background: #F3F4F6;
  color: #4B5563;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.15s;
}
.filter-chip.active {
  background: #07C160;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

/* ============ 时间提示行 ============ */
.time-hint {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  font-size: 24rpx;
  color: #6B7280;
  background: #FFFFFF;
}
.hint-text {
  color: #6B7280;
}
.hint-more {
  color: #07C160;
  font-weight: 600;
  flex-shrink: 0;
}
.hint-disabled {
  color: #BBBBBB;
  font-weight: 400;
}

/* ============ 月份标题 ============ */
.month-title {
  padding: 24rpx 32rpx 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
  letter-spacing: 1rpx;
}

/* ============ 订单列表卡片（对齐"我的工单"排版） ============ */
.order-list {
  padding: 20rpx 24rpx;
}
.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.card-meta {
  font-size: 24rpx;
  color: #9CA3AF;
}
.status-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}
.status-1 { background: #FEF3C7; color: #D97706; }
.status-2 { background: #DBEAFE; color: #2563EB; }
.status-3 { background: #E0E7FF; color: #4F46E5; }
.status-4 { background: #D1FAE5; color: #059669; }
.status-5 { background: #FEE2E2; color: #DC2626; }

.card-body { margin-bottom: 16rpx; }
.type-row { display: flex; align-items: center; margin-bottom: 14rpx; }
.type-tag { flex-shrink: 0; font-size: 22rpx; color: #07C160; background: #E7F8EE; padding: 4rpx 16rpx; border-radius: 20rpx; margin-right: 14rpx; }
.item-name { font-size: 30rpx; font-weight: 600; color: #1F2937; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.info-line { display: flex; align-items: flex-start; font-size: 26rpx; color: #6B7280; margin-top: 8rpx; line-height: 1.4; }
.line-key { flex-shrink: 0; width: 120rpx; color: #9CA3AF; }
.line-val { flex: 1; color: #1F2937; }

.card-photos { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.photo-thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #F3F4F6; }

.card-actions { display: flex; gap: 12rpx; align-items: center; border-top: 1rpx solid #F3F4F6; padding-top: 20rpx; }
.detail-link { font-size: 24rpx; color: #07C160; padding: 6rpx 0; margin-left: auto; flex-shrink: 0; }

/* ============ 加载状态 ============ */
.loading-state {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #9CA3AF;
  font-size: 24rpx;
  gap: 16rpx;
}
.loading-icon {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E5E7EB;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ============ 空状态 ============ */
.empty-state {
  padding: 120rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.empty-icon {
  font-size: 100rpx;
  opacity: 0.5;
}
.empty-text {
  font-size: 28rpx;
  color: #6B7280;
}
.empty-btn {
  margin-top: 8rpx;
  background: #07C160;
  color: #FFFFFF;
  border-radius: 100rpx;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
.empty-btn::after {
  border: none;
}

/* ============ 底部提示 ============ */
.footer-tip {
  text-align: center;
  padding: 32rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}
