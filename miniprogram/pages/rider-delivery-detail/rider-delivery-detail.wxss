/* pages/rider-delivery-detail/rider-delivery-detail.wxss */
.page {
  min-height: 100vh;
  background: #F7F8FA;
  padding-bottom: 40rpx;
}

/* 状态条 */
.status-bar {
  padding: 40rpx 32rpx;
  color: #fff;
}
.status-text {
  font-size: 40rpx;
  font-weight: 700;
}
.status-no {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

/* 卡片 */
.card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 20rpx;
}

/* 商品 */
.goods {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  background: #E5E7EB;
  flex-shrink: 0;
}
.goods-info {
  flex: 1;
  min-width: 0;
}
.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-attr {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.attr-key {
  font-size: 24rpx;
  color: #9CA3AF;
}
.attr-val {
  font-size: 24rpx;
  color: #374151;
  font-weight: 500;
}
.goods-points {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #FF8C42;
  font-weight: 600;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.info-row:last-child { border-bottom: none; }
.info-key {
  font-size: 26rpx;
  color: #6B7280;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.info-val {
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}
/* 收货地址：长文本左对齐换行 */
.address-row { align-items: flex-start; }
.address-val {
  text-align: left;
  flex: 1;
  line-height: 1.5;
}

/* 地图 */
.order-map {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  margin: 16rpx 0;
  background: #E5E7EB;
}

/* 按钮行：导航 / 联系收货人，按内容收缩成药丸 */
.row-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  font-size: 28rpx;
  padding: 0 36rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  color: #fff;
  margin: 0;
  min-width: 0;
  box-sizing: border-box;
}
.action-nav { background: #F97316; }
.action-call { background: #2563EB; }
.action-hover { opacity: 0.75; }

/* 操作按钮（卡片内） */
.action-card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  padding: 24rpx;
}
.action-btn-wrap {
  display: flex;
  justify-content: center;
}
.action-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  padding: 0 56rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin: 0;
  min-width: 0;
  box-sizing: border-box;
}
.done-tip {
  text-align: center;
  color: #10B981;
  font-size: 30rpx;
  padding: 20rpx 0;
}

.loading {
  text-align: center;
  color: #9CA3AF;
  padding: 80rpx 0;
  font-size: 28rpx;
}
