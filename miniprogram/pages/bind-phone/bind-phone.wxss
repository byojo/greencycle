/* pages/bind-phone/bind-phone.wxss */
.page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.header { margin-bottom: 32rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #1F2937; }
.subtitle { font-size: 26rpx; color: #9CA3AF; margin-top: 12rpx; }

.status-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
}
.status-label { font-size: 26rpx; color: #9CA3AF; }
.status-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #07C160;
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

.btn-auth {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
.btn-auth::after { border: none; }

.auth-tip {
  text-align: center;
  font-size: 22rpx;
  color: #C4C9D1;
  margin-top: 16rpx;
}

.divider {
  display: flex;
  align-items: center;
  color: #C4C9D1;
  font-size: 24rpx;
  margin: 48rpx 0;
}
.divider::before, .divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #E5E7EB;
}
.divider text { padding: 0 24rpx; }

.manual-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 92rpx;
}
.manual-input {
  flex: 1;
  height: 92rpx;
  font-size: 30rpx;
  color: #1F2937;
}
.btn-save {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 36rpx;
  border-radius: 32rpx;
  background: #07C160;
  color: #fff;
  font-size: 28rpx;
  border: none;
}
.btn-save::after { border: none; }
.btn-save[disabled] { opacity: 0.5; }

.skip {
  text-align: center;
  margin-top: 60rpx;
  font-size: 28rpx;
  color: #9CA3AF;
}
