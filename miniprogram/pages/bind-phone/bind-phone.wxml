<!--pages/bind-phone/bind-phone.wxml-->
<view class="page">
  <view class="header">
    <view class="title">绑定手机号</view>
    <view class="subtitle">绑定后，回收专员才能联系您上门取件</view>
  </view>

  <!-- 当前状态 -->
  <view class="status-card">
    <view class="status-label">当前手机号</view>
    <view class="status-value">{{currentPhone ? maskedPhone : '未绑定'}}</view>
  </view>

  <!-- 方式一：微信授权 -->
  <button
    class="btn-auth"
    open-type="getPhoneNumber"
    bindgetphonenumber="onGetPhone"
  >📱 微信授权绑定</button>
  <view class="auth-tip">需微信认证企业/个体户主体，点击即授权，无需手输</view>

  <!-- 分隔 -->
  <view class="divider"><text>或手动填写</text></view>

  <!-- 方式二：手动填写 -->
  <view class="manual-box">
    <input
      class="manual-input"
      type="number"
      maxlength="11"
      placeholder="请输入手机号"
      value="{{manualPhone}}"
      bindinput="onManualInput"
    />
    <button class="btn-save" bindtap="onSaveManual" disabled="{{loading}}">保存</button>
  </view>

  <view class="skip" bindtap="onSkip">暂不绑定</view>
</view>
