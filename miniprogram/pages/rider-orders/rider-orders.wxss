.page { min-height: 100vh; background: #F7F8FA; }

/* 顶部 Tab */
.top-tabs { display: flex; background: #fff; padding: 0 24rpx; border-bottom: 1rpx solid #F3F4F6; }
.top-tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 30rpx; color: #6B7280; position: relative; }
.top-tab.active { color: #07C160; font-weight: 600; }
.top-tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 60rpx; height: 4rpx; background: #07C160; border-radius: 2rpx; }

/* 筛选 chips（时间 + 状态共用） */
.chip-bar { white-space: nowrap; padding: 16rpx 24rpx; background: #fff; }
.chip-bar + .chip-bar { padding-top: 0; }
.chip { display: inline-block; padding: 8rpx 28rpx; margin-right: 16rpx; border-radius: 32rpx; font-size: 26rpx; color: #6B7280; background: #F3F4F6; }
.chip.active { background: #07C160; color: #fff; }

/* 时间范围提示 */
.section-tip { font-size: 22rpx; color: #9CA3AF; padding: 12rpx 28rpx 0; }

/* 列表 */
.order-list, .delivery-list { padding: 20rpx 24rpx; }

/* 统一卡片 */
.order-card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.card-no { font-size: 24rpx; color: #9CA3AF; }
.status-badge { padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; }
.status-1 { background: #FEF3C7; color: #D97706; }
.status-2 { background: #DBEAFE; color: #2563EB; }
.status-3 { background: #E0E7FF; color: #4F46E5; }
.status-4 { background: #D1FAE5; color: #059669; }
.status-5 { background: #FEE2E2; color: #DC2626; }
.delivery-status { font-size: 26rpx; font-weight: 600; }

.card-body { margin-bottom: 16rpx; }
.card-item { display: block; font-size: 32rpx; font-weight: 600; color: #1F2937; margin-bottom: 10rpx; }
.card-line { display: block; font-size: 26rpx; color: #6B7280; margin-top: 6rpx; line-height: 1.4; }

.card-photos { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.photo-thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #F3F4F6; }

.card-thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-bottom: 16rpx; background: #F3F4F6; }

.card-actions { display: flex; gap: 16rpx; align-items: center; border-top: 1rpx solid #F3F4F6; padding-top: 20rpx; }
.detail-link { font-size: 24rpx; color: #07C160; padding: 8rpx 0 8rpx 16rpx; }
.action-btn { font-size: 26rpx; padding: 0 32rpx; height: 68rpx; line-height: 68rpx; border-radius: 34rpx; text-align: center; border: none; color: #fff; }
.action-btn::after { border: none; }
.action-green { background: #07C160; }
.action-blue { background: #2563EB; }
.action-nav { background: #F97316; }

/* 通用 */
.empty, .loading { text-align: center; padding: 120rpx 0; color: #9CA3AF; font-size: 28rpx; }

/* 弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal { background: #fff; border-radius: 24rpx; padding: 40rpx; width: 680rpx; box-sizing: border-box; }
.modal-title { font-size: 34rpx; font-weight: 600; margin-bottom: 30rpx; }
.input-group { margin-bottom: 16rpx; }
.input-label { display: block; font-size: 26rpx; color: #6B7280; margin-bottom: 12rpx; }
.input { width: 100%; height: 80rpx; padding: 0 24rpx; background: #F3F4F6; border-radius: 12rpx; font-size: 30rpx; box-sizing: border-box; line-height: 80rpx; }
.input-hint { font-size: 24rpx; color: #9CA3AF; margin-bottom: 24rpx; }
.modal-actions { display: flex; gap: 20rpx; justify-content: flex-end; margin-top: 30rpx; }
.modal-btn { min-width: 160rpx; height: 72rpx; line-height: 72rpx; border-radius: 36rpx; font-size: 28rpx; text-align: center; padding: 0; margin: 0; border: none; }
.modal-btn::after { border: none; }
.modal-btn-green { background: #07C160; color: #fff; }
.modal-btn-gray { background: #F3F4F6; color: #6B7280; }
