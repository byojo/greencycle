<view class="page">
  <!-- 顶部 Tab：回收工单 / 配送任务 -->
  <view class="top-tabs">
    <view class="top-tab {{currentTab === 0 ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="0">回收工单</view>
    <view class="top-tab {{currentTab === 1 ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="1">配送任务</view>
  </view>

  <!-- ========== 回收工单 ========== -->
  <block wx:if="{{currentTab === 0}}">
    <!-- 状态筛选 -->
    <scroll-view scroll-x class="chip-bar">
      <view class="chip {{currentFilter === item.value ? 'active' : ''}}" wx:for="{{filters}}" wx:key="value" data-value="{{item.value}}" bindtap="onFilter">{{item.label}}</view>
    </scroll-view>

    <view class="order-list" wx:if="{{filteredOrders.length > 0}}">
      <view class="order-card" wx:for="{{filteredOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="onViewDetail">
        <view class="card-head">
          <text class="card-no">单号 {{item.orderNo}}</text>
          <view class="status-badge status-{{item.status}}">{{statusMap[item.status]}}</view>
        </view>
        <view class="card-body">
          <view class="type-row">
            <view class="type-tag">{{item.categoryName || '其他'}}</view>
            <text class="item-name">{{item.itemName}}</text>
          </view>
          <view class="info-line"><text class="line-key">预约时间</text><text class="line-val">{{item.estimatedAtText || '尽快上门'}}</text></view>
          <view class="info-line"><text class="line-key">联系方式</text><text class="line-val">{{item.customerPhone || '—'}}</text></view>
          <view class="info-line"><text class="line-key">地址</text><text class="line-val">{{item.pickupAddr}}</text></view>
        </view>
        <view class="card-photos" wx:if="{{item.images && item.images.length > 0}}">
          <image wx:for="{{item.images}}" wx:for-item="img" wx:key="id" src="{{img.url}}" mode="aspectFill" class="photo-thumb" catchtap="onPreviewPhoto" data-urls="{{item.images}}" data-current="{{img.url}}"></image>
        </view>
        <view class="card-actions" catchtap="stopPropagation">
          <button class="action-btn action-nav" data-lat="{{item.pickupLat}}" data-lng="{{item.pickupLng}}" data-addr="{{item.pickupAddr}}" bindtap="onNavigate">🧭 导航</button>
          <button wx:if="{{item.status === 2}}" class="action-btn action-blue" data-id="{{item.id}}" bindtap="onPick">已取件</button>
          <button wx:if="{{item.status === 3}}" class="action-btn action-green" data-id="{{item.id}}" bindtap="onShowComplete">完成回收</button>
          <view class="detail-link" data-id="{{item.id}}" bindtap="onViewDetail">详情 ›</view>
        </view>
      </view>
    </view>

    <!-- 底部：逐月往前查看 -->
    <view class="month-footer">
      <view wx:if="{{orders.length === 0 && canLoadPrev}}" class="month-hint">本月暂无工单</view>
      <button wx:if="{{canLoadPrev}}" class="prev-month-btn" bindtap="onViewPrevMonth" disabled="{{loadingPrev}}">轻按查看 {{prevMonthLabel}} 工单</button>
      <view wx:if="{{reachedEnd && orders.length > 0}}" class="month-end">已无更早工单</view>
    </view>

    <view class="empty" wx:if="{{!loading && filteredOrders.length === 0 && !(orders.length === 0 && canLoadPrev)}}">暂无回收工单</view>
  </block>

  <!-- ========== 配送任务 ========== -->
  <block wx:if="{{currentTab === 1}}">
    <view class="delivery-list" wx:if="{{deliveries.length > 0}}">
      <view class="order-card" wx:for="{{deliveries}}" wx:key="id">
        <view class="card-head">
          <text class="card-no">配送 #{{item.id}}</text>
          <view class="delivery-status" style="color:{{item.status === 2 ? '#3B82F6' : '#10B981'}}">{{item.status === 2 ? '配送中' : '已送达'}}</view>
        </view>
        <view class="card-body">
          <view class="card-item">{{item.itemName}}</view>
          <view class="card-line">📍 {{item.deliveryAddr}}</view>
          <view class="card-line">👤 {{item.deliveryName}} {{item.deliveryPhone}}</view>
        </view>
        <image class="card-thumb" wx:if="{{item.itemImage}}" src="{{item.itemImage}}" mode="aspectFill" />
        <view class="card-actions" catchtap="stopPropagation">
          <button class="action-btn action-nav" data-lat="{{item.deliveryLat}}" data-lng="{{item.deliveryLng}}" data-addr="{{item.deliveryAddr}}" bindtap="onNavigate">🧭 导航</button>
          <button wx:if="{{item.status === 2}}" class="action-btn action-green" data-id="{{item.id}}" bindtap="onCompleteDelivery">确认送达</button>
          <view class="detail-link" data-id="{{item.id}}" bindtap="onViewDelivery">详情 ›</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && deliveries.length === 0}}">暂无配送任务</view>
  </block>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <!-- 完成订单弹窗 -->
  <view class="modal-mask" wx:if="{{showComplete}}" bindtap="closeComplete">
    <view class="modal" catchtap="stopPropagation">
      <view class="modal-title">✅ 完成回收</view>
      <view class="input-group">
        <text class="input-label">回收金额（元）</text>
        <input type="digit" class="input" value="{{finalAmount}}" bindinput="onAmountInput" placeholder="50" />
      </view>
      <view class="input-hint">用户将获得积分 = 品类基础分 + 金额×5%</view>
      <view class="modal-actions">
        <button class="modal-btn modal-btn-gray" bindtap="closeComplete">取消</button>
        <button class="modal-btn modal-btn-green" bindtap="confirmComplete">确认完成</button>
      </view>
    </view>
  </view>
</view>
