.page { min-height: 100vh; background: #F7F8FA; }
.filters { display: flex; white-space: nowrap; padding: 16rpx 24rpx; gap: 16rpx; }
.filter { display: inline-block; padding: 8rpx 28rpx; border-radius: 32rpx; font-size: 26rpx; color: #666; background: #fff; border: 1px solid #E5E7EB; }
.filter.active { background: #07C160; color: #fff; border-color: #07C160; }
.order-list { padding: 0 24rpx; }
.order-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.order-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.order-no { font-size: 24rpx; color: #9CA3AF; }
.status-badge { padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; }
.status-1 { background: #FEF3C7; color: #D97706; }
.status-2 { background: #DBEAFE; color: #2563EB; }
.status-3 { background: #E0E7FF; color: #4F46E5; }
.status-4 { background: #D1FAE5; color: #059669; }
.status-5 { background: #FEE2E2; color: #DC2626; }
.order-info { margin-bottom: 12rpx; }
.order-item { display: block; font-size: 30rpx; font-weight: 600; color: #1F2937; }
.order-addr { display: block; font-size: 26rpx; color: #6B7280; margin-top: 8rpx; }
.order-rider { font-size: 26rpx; color: #2563EB; margin-bottom: 16rpx; }
.order-actions { display: flex; gap: 16rpx; flex-wrap: wrap; }
.btn { font-size: 24rpx; }
.btn-green { background: #07C160; color: #fff; }
.btn-blue { background: #2563EB; color: #fff; }
.btn-gray { background: #F3F4F6; color: #6B7280; }
.empty, .loading { text-align: center; padding: 120rpx 0; color: #9CA3AF; font-size: 28rpx; }
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal { background: #fff; border-radius: 24rpx; padding: 40rpx; width: 600rpx; }
.modal-title { font-size: 34rpx; font-weight: 600; margin-bottom: 30rpx; }
.picker { padding: 20rpx; background: #F3F4F6; border-radius: 12rpx; font-size: 28rpx; }
.input-group { margin-bottom: 16rpx; }
.input-label { display: block; font-size: 26rpx; color: #6B7280; margin-bottom: 12rpx; }
.input { width: 100%; padding: 20rpx; background: #F3F4F6; border-radius: 12rpx; font-size: 28rpx; }
.input-hint { font-size: 24rpx; color: #9CA3AF; margin-bottom: 24rpx; }
.modal-actions { display: flex; gap: 20rpx; justify-content: flex-end; margin-top: 30rpx; }
