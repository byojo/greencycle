<view class="page">
  <!-- 筛选 -->
  <scroll-view scroll-x class="filters">
    <view class="filter {{currentFilter === item.value ? 'active' : ''}}" wx:for="{{filters}}" wx:key="value" data-value="{{item.value}}" bindtap="onFilter">{{item.label}}</view>
  </scroll-view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <view class="order-top">
        <text class="order-no">{{item.orderNo}}</text>
        <view class="status-badge status-{{item.status}}">{{statusMap[item.status]}}</view>
      </view>
      <view class="order-info">
        <text class="order-item">{{item.itemName}}</text>
        <text class="order-addr">📍 {{item.pickupAddr}}</text>
      </view>
      <view class="order-rider" wx:if="{{item.riderName}}">回收专员：{{item.riderName}} {{item.riderPhone}}</view>
      <view class="order-actions">
        <button wx:if="{{item.status === 1}}" class="btn btn-blue" size="mini" data-id="{{item.id}}" bindtap="onAssign">派单</button>
        <button wx:if="{{item.status === 2}}" class="btn btn-gray" size="mini" data-id="{{item.id}}" data-status="3" bindtap="onUpdateStatus">已取件</button>
        <button wx:if="{{item.status === 3}}" class="btn btn-green" size="mini" data-id="{{item.id}}" bindtap="onComplete">完成</button>
        <button wx:if="{{item.status === 1}}" class="btn btn-gray" size="mini" data-id="{{item.id}}" data-status="5" bindtap="onUpdateStatus">取消</button>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && orders.length === 0}}">暂无订单</view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <!-- 派单弹窗 -->
  <view class="modal-mask" wx:if="{{showAssign}}" bindtap="closeAssign">
    <view class="modal" catchtap="">
      <view class="modal-title">📋 派单</view>
      <picker bindchange="onRiderPick" value="{{riderIndex}}" range="{{riders}}" range-key="label">
        <view class="picker">{{riders[riderIndex] ? riders[riderIndex].label : '请选择回收专员'}}</view>
      </picker>
      <view class="modal-actions">
        <button class="btn btn-gray" bindtap="closeAssign">取消</button>
        <button class="btn btn-green" bindtap="confirmAssign">确认派单</button>
      </view>
    </view>
  </view>

  <!-- 完成弹窗 -->
  <view class="modal-mask" wx:if="{{showComplete}}" bindtap="closeComplete">
    <view class="modal" catchtap="">
      <view class="modal-title">✅ 完成订单</view>
      <view class="input-group">
        <text class="input-label">回收金额（元）</text>
        <input type="digit" class="input" value="{{finalAmount}}" bindinput="onAmountInput" placeholder="50" />
      </view>
      <view class="input-hint">用户将获得积分 = 品类基础分 + 金额×5%</view>
      <view class="modal-actions">
        <button class="btn btn-gray" bindtap="closeComplete">取消</button>
        <button class="btn btn-green" bindtap="confirmComplete">确认完成</button>
      </view>
    </view>
  </view>
</view>
