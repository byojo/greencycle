/* pages/rider-order-detail/rider-order-detail.wxss */
.page {
  min-height: 100vh;
  background: #F7F8FA;
  padding-bottom: 40rpx;
}

/* 状态条 */
.status-bar {
  padding: 40rpx 32rpx;
  color: #fff;
}
.status-text {
  font-size: 40rpx;
  font-weight: 700;
}

/* 卡片 */
.card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 20rpx;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}
.item-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.photo-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #E5E7EB;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.info-row:last-child { border-bottom: none; }
.info-key {
  font-size: 26rpx;
  color: #6B7280;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.info-val {
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 500;
  text-align: right;
}

/* 工单号醒目展示 */
.orderno-text {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 600;
  letter-spacing: 0;
}

/* 地图 */
.order-map {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  margin: 16rpx 0;
  background: #E5E7EB;
}
.row-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}
/* 用 <view> 模拟按钮，避 WeChat <button> 默认 display/padding/width 撑宽问题 */
.btn-nav, .btn-call {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 36rpx;
  border-radius: 38rpx;
  border: none;
  color: #fff;
  box-sizing: border-box;
  min-width: 0;
}
.action-hover { opacity: 0.7; }
.btn-nav { background: #F97316; }
.btn-call { background: #2563EB; }

/* 主操作区：与上方按钮用分割线分组；flex 居中让内容宽药丸居中显示 */
.row-action {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F3F4F6;
}
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 56rpx;
  border-radius: 44rpx;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-sizing: border-box;
  min-width: 0;
  margin: 0;
}
.done-tip {
  text-align: center;
  color: #10B981;
  font-size: 30rpx;
  padding: 20rpx 0;
}

.loading {
  text-align: center;
  color: #9CA3AF;
  padding: 80rpx 0;
  font-size: 28rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
}
.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
}
.input-group {
  margin-bottom: 16rpx;
}
.input-label {
  font-size: 26rpx;
  color: #6B7280;
}
.input {
  margin-top: 12rpx;
  height: 80rpx;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
}
.input-hint {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-bottom: 28rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  border: none;
  font-size: 30rpx;
}
.modal-btn::after { border: none; }
.modal-btn-gray { background: #F3F4F6; color: #374151; }
.modal-btn-green { background: #07C160; color: #fff; }