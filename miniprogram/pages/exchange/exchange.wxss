/* pages/exchange/exchange.wxss */

.page {
  min-height: 100vh;
  background: #F7F8FA;
}

/* 积分卡 */
.points-card {
  background: linear-gradient(135deg, #07C160 0%, #10B981 100%);
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.points-info {
  display: flex;
  flex-direction: column;
}
.points-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}
.points-num {
  font-size: 56rpx;
  font-weight: bold;
}
.points-hint {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 标题区：可兑换商品 + 兑换记录 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 12rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.section-action {
  font-size: 26rpx;
  color: #07C160;
  padding: 8rpx 0;
}

/* 商品网格 */
.items-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}
.item-card {
  width: calc(50% - 16rpx);
  background: white;
  border-radius: 16rpx;
  margin: 8rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.item-image-wrap {
  position: relative;
  width: 100%;
  height: 340rpx;
  overflow: hidden;
}
.item-image {
  width: 100%;
  height: 100%;
}
.item-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}
.item-stock {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.6));
  color: white;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
}
.item-soldout {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0,0,0,0.6);
  color: white;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
}
.item-info {
  padding: 20rpx;
}
.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.item-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-points {
  display: flex;
  align-items: center;
  color: #07C160;
}
.points-icon {
  margin-right: 4rpx;
}
.points-value {
  font-size: 32rpx;
  font-weight: bold;
}
.points-unit {
  font-size: 24rpx;
  margin-left: 4rpx;
}

/* Loading & Empty */
.loading, .empty {
  text-align: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-content {
  background: white;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}
.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}
.modal-item {
  display: flex;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.modal-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.modal-image-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}
.modal-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}
.modal-item-info {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.modal-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.modal-item-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: auto;
}
.modal-item-points {
  font-size: 32rpx;
  font-weight: bold;
  color: #07C160;
}
.address-section {
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.address-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.address-value {
  display: flex;
  flex-direction: column;
}
.address-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}
.address-detail {
  font-size: 26rpx;
  color: #666;
}
.address-empty {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #07C160;
  font-size: 28rpx;
}
.arrow {
  font-size: 32rpx;
}
.modal-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* 数量加减器 */
.qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
  margin-bottom: 8rpx;
}
.qty-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.qty-stepper {
  display: flex;
  align-items: center;
  background: #F7F8FA;
  border-radius: 40rpx;
  padding: 6rpx;
  gap: 6rpx;
}
.qty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 50%;
  background: #fff;
  color: #07C160;
  font-size: 36rpx;
  font-weight: 600;
  margin: 0;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.06);
}
.qty-btn-hover { background: #E5E7EB; }
.qty-input {
  width: 90rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
}

.btn-exchange {
  background: #07C160;
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx;
  border: none;
}
.btn-exchange::after {
  border: none;
}
