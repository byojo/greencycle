<!--pages/exchange/exchange.wxml-->
<view class="page">
  <!-- 顶部导航 -->
  <view class="nav">
    <view class="nav-inner">
      <view class="nav-back" bindtap="onBack">
        <text class="back-icon">‹</text>
      </view>
      <view class="nav-title">积分商城</view>
      <view class="nav-action" bindtap="onGoHistory">兑换记录</view>
    </view>
  </view>

  <!-- 我的积分卡 -->
  <view class="points-card">
    <view class="points-info">
      <view class="points-label">我的积分</view>
      <view class="points-num">{{myPoints}}</view>
    </view>
    <view class="points-hint">积分可兑换好礼</view>
  </view>

  <!-- 商品列表 -->
  <view class="section-title">可兑换商品</view>
  <view class="items-grid" wx:if="{{!loading}}">
    <view
      class="item-card"
      wx:for="{{items}}"
      wx:key="id"
      data-item="{{item}}"
      bindtap="onItemTap"
    >
      <view class="item-image-wrap">
        <image class="item-image" wx:if="{{item.image && !item.imageError}}" src="{{item.image}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}" />
        <view class="item-placeholder" wx:if="{{!item.image || item.imageError}}" style="background:{{item.bgColor}}">
          <text>{{item.icon}}</text>
        </view>
        <view class="item-stock" wx:if="{{item.stock <= 10 && item.stock > 0}}">仅剩 {{item.stock}}</view>
        <view class="item-soldout" wx:if="{{item.stock <= 0}}">已兑完</view>
      </view>
      <view class="item-info">
        <view class="item-name">{{item.name}}</view>
        <view class="item-desc">{{item.desc}}</view>
        <view class="item-points">
          <text class="points-icon">🌱</text>
          <text class="points-value">{{item.points}}</text>
          <text class="points-unit">积分</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Loading -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- Empty -->
  <view class="empty" wx:if="{{!loading && items.length === 0}}">
    <text>暂无商品</text>
  </view>

  <!-- 兑换确认弹窗 -->
  <view class="modal-mask" wx:if="{{showConfirm}}" bindtap="onCloseConfirm">
    <view class="modal-content" catchtap="">

      <view class="modal-header">
        <text class="modal-title">确认兑换</text>
        <view class="modal-close" bindtap="onCloseConfirm">×</view>
      </view>

      <view class="modal-item" wx:if="{{selectedItem}}">
        <view class="modal-image-wrap">
          <image class="modal-image" wx:if="{{selectedItem.image && !selectedItem.imageError}}" src="{{selectedItem.image}}" mode="aspectFill" />
          <view class="modal-placeholder" wx:if="{{!selectedItem.image || selectedItem.imageError}}" style="background:{{selectedItem.bgColor}}">
            <text>{{selectedItem.icon}}</text>
          </view>
        </view>
        <view class="modal-item-info">
          <view class="modal-item-name">{{selectedItem.name}}</view>
          <view class="modal-item-desc">{{selectedItem.desc}}</view>
          <view class="modal-item-points">
            <text>🌱 {{selectedItem.points}} 积分</text>
          </view>
        </view>
      </view>

      <!-- 收货地址 -->
      <view class="address-section" bindtap="onSelectAddress">
        <view class="address-label">收货地址</view>
        <view class="address-value" wx:if="{{selectedAddress}}">
          <view class="address-name">{{selectedAddress.name}} {{selectedAddress.phone}}</view>
          <view class="address-detail">{{selectedAddress.province}}{{selectedAddress.city}}{{selectedAddress.district}}{{selectedAddress.detail}}</view>
        </view>
        <view class="address-empty" wx:if="{{!selectedAddress}}">
          <text>请选择收货地址</text>
          <text class="arrow">›</text>
        </view>
      </view>

      <view class="modal-tip">
        <text>扣除 {{selectedItem.points}} 积分，商品将在 7 个工作日内配送送达</text>
      </view>

      <button class="btn-exchange" bindtap="onExchange">确认兑换</button>
    </view>
  </view>
</view>
